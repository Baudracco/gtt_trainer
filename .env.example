POSTGRES_PASSWORD=replace-with-a-strong-local-password
APP_ENV=development
APP_ORIGIN=http://localhost:8080
# Optional alternate raster provider; empty uses bundled OpenFreeMap/OSM vector style.
VITE_TILE_URL=
VITE_TILE_ATTRIBUTION=
# Set 0 to pause GTT HTTP downloads (the last validated bundle remains usable).
GTFS_DOWNLOAD_ENABLED=1
# Private backups run in their own container/volume; retain the seven latest complete copies.
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=7
# Set only when selecting an already restored isolated database for a planned cutover.
POSTGRES_DB=gtt_trainer
# Production HTTPS override only: public hostname, without scheme, path or port.
APP_DOMAIN=
